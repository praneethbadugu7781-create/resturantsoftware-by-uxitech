generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model Restaurant {
  id           String          @id @default(uuid()) @map("_id")
  name         String
  address      String
  phone        String
  email        String
  logo         String?
  gstNumber    String?
  restaurantType String?
  gstPercent   Float          @default(5)
  createdAt    DateTime        @default(now())
  users        User[]
  tables       Table[]
  categories   Category[]
  menuItems    MenuItem[]
  reservations Reservation[]
  bills        Bill[]
  inventory    InventoryItem[]
  suppliers    Supplier[]
  customers    Customer[]
  auditLogs    AuditLog[]
}

model User {
  id              String            @id @default(uuid()) @map("_id")
  restaurantId    String
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  email           String            @unique
  password        String
  role            String
  phone           String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  attendances     StaffAttendance[]
  auditLogs       AuditLog[]
}

model Table {
  id           String         @id @default(uuid()) @map("_id")
  restaurantId String
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableNumber  String
  capacity     Int
  area         String
  status       String         @default("AVAILABLE")
  x            Float          @default(0)
  y            Float          @default(0)
  qrToken      String         @unique
  qrImageUrl   String?
  createdAt    DateTime       @default(now())
  reservations Reservation[]
  orders       Order[]
  bills        Bill[]
  sessions     TableSession[]
}

model Reservation {
  id           String            @id @default(uuid()) @map("_id")
  restaurantId String
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String?
  table        Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestCount   Int
  date         DateTime
  timeSlot     String
  status       String            @default("PENDING")
  notes        String?
  createdAt    DateTime          @default(now())
}

model Category {
  id           String      @id @default(uuid()) @map("_id")
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  menuItems    MenuItem[]
}

model MenuItem {
  id              String      @id @default(uuid()) @map("_id")
  restaurantId    String
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId      String?
  categoryRef     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String
  description     String
  price           Float
  category        String
  image           String?
  isAvailable     Boolean     @default(true)
  isVeg           Boolean     @default(true)
  preparationTime Int         @default(15)
  createdAt       DateTime    @default(now())
  orderItems      OrderItem[]
  options         MenuItemOptionGroup[]
  recipe          RecipeIngredient[]
}

model Order {
  id           String      @id @default(uuid()) @map("_id")
  restaurantId String
  tableId      String
  table        Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  sessionId    String
  session      TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status       String      @default("PENDING")
  orderType    String
  totalAmount  Float
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id                  String      @id @default(uuid()) @map("_id")
  orderId             String
  order               Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId           String
  menuItem             MenuItem    @relation(fields: [menuItemId], references: [id])
  quantity             Int
  unitPrice            Float
  specialInstructions  String?
  status               String      @default("PENDING")
  selectedOptions      String?
}

model Bill {
  id             String        @id @default(uuid()) @map("_id")
  restaurantId   String
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId        String
  table          Table         @relation(fields: [tableId], references: [id])
  sessionId      String
  orderIds       String
  subtotal       Float
  gstAmount      Float
  gstPercent     Float
  serviceCharge  Float         @default(0)
  discount       Float         @default(0)
  totalAmount    Float
  paymentMethod  String        @default("CASH")
  paymentStatus  String        @default("PENDING")
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  splitBills     String?
}

model InventoryItem {
  id            String     @id @default(uuid()) @map("_id")
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name          String
  unit          String
  currentStock  Float
  minStock      Float
  costPerUnit   Float
  category      String
  supplierId    String?
  supplier      Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  updatedAt     DateTime   @updatedAt
  recipeIngredients RecipeIngredient[]
}

model Supplier {
  id             String           @id @default(uuid()) @map("_id")
  restaurantId   String
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  email          String?
  address        String?
  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @map("_id")
  restaurantId String
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  items        String
  totalCost    Float
  status       String              @default("ORDERED")
  createdAt    DateTime            @default(now())
}

model StaffAttendance {
  id          String    @id @default(uuid()) @map("_id")
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float?
  status      String
}

model Customer {
  id           String        @id @default(uuid()) @map("_id")
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  totalVisits  Int           @default(0)
  lastVisit    DateTime?
  totalSpent   Float         @default(0)
  tag          String        @default("New")
  notes        String?
  reservations Reservation[]
  orders       Order[]
}

model TableSession {
  id            String        @id @default(uuid()) @map("_id")
  tableId       String
  table         Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  startTime     DateTime      @default(now())
  endTime       DateTime?
  status        String        @default("ACTIVE")
  customerCount Int           @default(1)
  totalBilled   Float         @default(0)
  orders        Order[]
}

model AuditLog {
  id           String     @id @default(uuid()) @map("_id")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  entity       String
  entityId     String?
  metadata     String?
  createdAt    DateTime   @default(now())
}

model MenuItemOptionGroup {
  id           String            @id @default(uuid()) @map("_id")
  menuItemId   String
  menuItem     MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name         String            // e.g., "Choose Size", "Select Add-ons"
  minSelect    Int               @default(0)
  maxSelect    Int               @default(1)
  isRequired   Boolean           @default(false)
  options      MenuItemOption[]

  @@index([menuItemId])
}

model MenuItemOption {
  id           String              @id @default(uuid()) @map("_id")
  groupId      String
  group        MenuItemOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String              // e.g., "Medium", "Extra Cheese"
  price        Float               @default(0)
  isAvailable  Boolean             @default(true)

  @@index([groupId])
}

model RecipeIngredient {
  id              String        @id @default(uuid()) @map("_id")
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Float         // e.g., 0.150 for 150g, 1 for 1 unit
  createdAt       DateTime      @default(now())

  @@index([menuItemId])
  @@index([inventoryItemId])
}
